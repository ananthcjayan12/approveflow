# Local development
APP_ORIGIN=http://localhost:8787
SESSION_SECRET=replace-with-32-plus-random-characters
RESEND_API_KEY=
EMAIL_FROM=ApproveFlow <approvals@example.com>

# R2 S3 credentials used only to sign direct browser uploads/downloads.
# In production R2_ACCOUNT_ID is derived automatically from CLOUDFLARE_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=approveflow-media

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_FREELANCER=
RAZORPAY_PLAN_AGENCY=

# Optional production resource-name overrides used by deploy:prepare
WORKER_NAME=approveflow
D1_DATABASE_NAME=approveflow-db
MAX_SINGLE_UPLOAD_BYTES=104857600
MAX_VIDEO_BYTES=5368709120
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
